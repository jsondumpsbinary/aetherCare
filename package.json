{
  "name": "aethercare",
  "version": "1.0.0",
  "description": "AetherCare is a desktop-based Hospital Management System (MVP) designed to simplify hospital operations through a centralized digital platform.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build:client": "npm --prefix client run build",
    "electron": "electron .",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT,ELECTRON\" -c \"yellow.bold,cyan.bold,green.bold\" \"npm run dev:server\" \"npm run dev:client\" \"electron .\"",
    "dist": "npm run build:client && electron-builder --mac dmg"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsondumpsbinary/aetherCare.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^10.0.7",
    "electron": "^45.3.1",
    "electron-builder": "^26.7.0"
  },
  "build": {
    "appId": "com.aethercare.desktop",
    "productName": "AetherCare",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "client/dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.medical",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "dmg": {
      "title": "AetherCare Installer",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
