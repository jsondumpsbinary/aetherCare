
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Patient {
  id          Int       @id @default(autoincrement())
  patientCode String    @unique
  name        String
  phone       String
  dateOfBirth DateTime?
  gender      String?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  opdVisits   OPDVisit[]
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  doctors   Doctor[]
  opdVisits OPDVisit[]
}

model Doctor {
  id           Int        @id @default(autoincrement())
  name         String
  departmentId Int
  createdAt    DateTime   @default(now())

  department   Department @relation(fields: [departmentId], references: [id])
  opdVisits    OPDVisit[]
}

model OPDVisit {
  id           Int      @id @default(autoincrement())
  tokenNumber  String
  visitDate    DateTime @default(now())
  status       String   @default("WAITING")

  patientId    Int
  doctorId     Int
  departmentId Int

  patient      Patient    @relation(fields: [patientId], references: [id])
  doctor       Doctor     @relation(fields: [doctorId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])

  createdAt    DateTime   @default(now())

  @@unique([departmentId, visitDate, tokenNumber])
  @@index([patientId])
  @@index([visitDate, status])
}
