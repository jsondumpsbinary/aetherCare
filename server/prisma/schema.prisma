generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Patient {
  id          Int       @id @default(autoincrement())
  patientCode String    @unique
  name        String
  phone       String
  dateOfBirth DateTime?
  gender      String?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  opdVisits   OPDVisit[]
  admissions  Admission[]
}

model Department {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  doctors   Doctor[]
  opdVisits OPDVisit[]
}

model Doctor {
  id           Int      @id @default(autoincrement())
  name         String
  departmentId Int
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id])
  opdVisits  OPDVisit[]
}

model OPDVisit {
  id          Int      @id @default(autoincrement())
  tokenNumber String
  visitDate   DateTime @default(now())
  status      String   @default("WAITING")

  patientId    Int
  doctorId     Int
  departmentId Int

  patient    Patient    @relation(fields: [patientId], references: [id])
  doctor     Doctor     @relation(fields: [doctorId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  createdAt DateTime @default(now())

  visitDay DateTime @db.Date

  @@unique([departmentId, visitDay, tokenNumber])
  @@index([patientId])
  @@index([visitDate, status])
}

enum BedType {
  GENERAL
  ICU
  PRIVATE
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

model Ward {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  beds        Bed[]
}

model Bed {
  id        Int       @id @default(autoincrement())
  bedNumber String    @unique
  bedType   BedType   @default(GENERAL)
  status    BedStatus @default(AVAILABLE)
  wardId    Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  ward       Ward        @relation(fields: [wardId], references: [id])
  admissions Admission[]

  @@index([wardId])
  @@index([status])
}

enum AdmissionStatus {
  ADMITTED
  DISCHARGED
  CANCELLED
}

model Admission {
  id            Int             @id @default(autoincrement())
  patientId     Int
  bedId         Int
  admissionDate DateTime        @default(now())
  dischargeDate DateTime?
  reason        String?
  status        AdmissionStatus @default(ADMITTED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  patient       Patient         @relation(fields: [patientId], references: [id])
  bed           Bed             @relation(fields: [bedId], references: [id])

  @@index([patientId])
  @@index([bedId])
  @@index([status])
}

enum UserRole {
  ADMIN
  RECEPTIONIST
  DOCTOR
  NURSE
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(RECEPTIONIST)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}